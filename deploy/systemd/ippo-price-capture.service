[Unit]
Description=Ippo Price Capture - Continuous orderbook snapshot daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/ippo
ExecStart=/opt/ippo/.venv/bin/python /opt/ippo/price_capture.py
Restart=always
RestartSec=30
Environment=PYTHONUNBUFFERED=1

MemoryMax=256M

StandardOutput=append:/opt/ippo/output/price_capture.log
StandardError=append:/opt/ippo/output/price_capture.log

[Install]
WantedBy=default.target
