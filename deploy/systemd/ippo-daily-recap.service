[Unit]
Description=Ippo Daily Recap - KPI summary via Telegram
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/ippo
ExecStart=/opt/ippo/.venv/bin/python /opt/ippo/daily_recap.py
Environment=PYTHONUNBUFFERED=1
TimeoutStartSec=120

MemoryMax=512M

StandardOutput=append:/opt/ippo/output/daily_recap_systemd.log
StandardError=append:/opt/ippo/output/daily_recap_systemd.log

[Install]
WantedBy=default.target
