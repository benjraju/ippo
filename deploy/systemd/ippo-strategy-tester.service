[Unit]
Description=Ippo Strategy Tester - scan, grade, report
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/ippo
ExecStart=/opt/ippo/.venv/bin/python strategy_tester.py run
Environment=PATH=/opt/ippo/.venv/bin:/usr/bin:/bin
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
