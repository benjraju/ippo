[Unit]
Description=Ippo AutoResearch - Continuous strategy improvement
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/ippo
ExecStart=/bin/bash -c 'while true; do /opt/ippo/.venv/bin/python -m autoresearch.research_loop --iterations 500 --no-claude --use-real-data; echo "[$(date -Iseconds)] Cycle complete, restarting..."; sleep 10; done'
Restart=always
RestartSec=30
Environment=PYTHONUNBUFFERED=1

MemoryMax=1G

StandardOutput=append:/opt/ippo/output/autoresearch_systemd.log
StandardError=append:/opt/ippo/output/autoresearch_systemd.log

[Install]
WantedBy=default.target
