# =============================================================================
# KALSHI SELF-IMPROVING BOT — Environment Variables
# =============================================================================
# INSTRUCTIONS:
# 1. Copy this file:  cp .env.template .env
# 2. Fill in your keys below
# 3. NEVER share your .env file with anyone
# =============================================================================

# --- Kalshi Demo API (FREE — get from https://demo.kalshi.co) ---
# Go to: Profile → Settings → API Keys → Create API Key
KALSHI_API_KEY_ID=your_kalshi_api_key_id_here
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# --- Kalshi Environment ---
# DEMO = paper trading (safe, free, no real money)
# PROD = real money (DO NOT USE until you are ready)
KALSHI_ENV=DEMO

# --- Anthropic API Key (for Claude intelligence) ---
# Get from: https://console.anthropic.com → API Keys → Create Key
ANTHROPIC_API_KEY=sk-ant-your_key_here

# --- Risk Settings (SAFE DEFAULTS — do not change unless you know what you're doing) ---
ACCOUNT_BALANCE=100
MAX_POSITION_PCT=0.02
MAX_DAILY_LOSS_PCT=0.08
KELLY_FRACTION=0.25
MAX_BET_DOLLARS=2

# --- AutoResearch Settings ---
AUTORESEARCH_MAX_ITERATIONS=50
AUTORESEARCH_TARGET_SHARPE=1.2
AUTORESEARCH_MAX_DRAWDOWN=0.08
